1807.js\"],\"I18nProvider\"]\n28:T436,"])</script><script>self.__next_f.push([1,"AppLovin deploys automated tooling to screen and flag ad content and advertisers' overall domains and assets for policy violations, including our \u003clink href=\"https://legal.applovin.com/policies-demand-partners/#:~:text=a.-,Prohibited%20Content,-Demand%20Partners%20may\"\u003eprohibited\u003c/link\u003e and \u003clink href=\"https://legal.applovin.com/policies-demand-partners/#:~:text=b.-,Restricted%20Content,-Demand%20Partners%20may\"\u003erestricted\u003c/link\u003e content categories. If the automated tools detect potential policy violations, they flag the ad or advertisers' overall domains or assets for further review, and we take appropriate action consistent with our \u003clink href=\"https://legal.applovin.com/policies-demand-partners/\"\u003ePolicies for Demand Partners\u003c/link\u003e.  If the tools flag advertiser accounts with repeat policy violations, their accounts will be subject to suspension or termination. You can learn more about the ad review process on our \u003clink href=\"https://legal.applovin.com/introduction-to-applovin-ad-content-policies/\"\u003eIntroduction to AppLovin’s Ad Content Policies\u003c/link\u003e page."])</script><script>self.__next_f.push([1,"3:[\"$\",\"$L27\",null,{\"data\":{\"data\":{\"en\":{\"translation\":{\"LogIn\":\"Log in\",\"SignUp\":\"Sign up\",\"HeaderLogIn\":\"Log in\",\"HeaderSignUp\":\"Sign up\",\"HomeHeroTitle\":\"Grow your\\nbusiness\",\"HomeTitle\":\"Advertise your business\",\"HomeHeroSubtitle\":\"Over a billion people play mobile games every day.\\nAppLovin lets you advertise to them.\",\"HomeHeroCtaLabel\":\"Launch a campaign\",\"HomeQuestion1\":\"How do I get started advertising with AppLovin?\",\"HomeQuestion2\":\"How does AppLovin Ads charge me?\",\"HomeQuestion3\":\"How can I monetize with AppLovin Max?\",\"HomeQuestion4\":\"I have a new game, can AppLovin get me new users?\",\"HomeQuestion5\":\"I have a makeup shop, d