export interface Localized {
  en: string;
  zh: string;
}

export type SectionKind = "university" | "course" | "certification";

export interface CvEducation {
  school: string;
  place: string;
  degree: Localized;
  period: string;
  detail: Localized;
  kind: SectionKind;
}

export interface CvExperience {
  role: Localized;
  company: string;
  place: string;
  period: string;
  detail: Localized;
}

export interface CvLanguage {
  name: string;
  level: Localized;
}

export interface CvReference {
  name: string;
  title: string;
  note: string;
}

export interface CvData {
  name: string;
  headline: Localized;
  location: string;
  contacts: {
    emailPrimary: string;
    emailSecondary: string;
    phone: string;
    linkedin: string;
    location: string;
  };
  summary: Localized;
  experience: CvExperience[];
  education: CvEducation[];
  languages: CvLanguage[];
  skills: string[];
  distinctions: Localized[];
  references: CvReference[];
}

